<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:local="using:Mantis_backdoor_scanner"
		mc:Ignorable="d"
		d:DesignWidth="1480"
		d:DesignHeight="980"
		x:Class="Mantis_backdoor_scanner.MainWindow"
		x:DataType="local:MainWindowViewModel"
		Title="Mantis Scanner"
		MinWidth="1320"
		MinHeight="840"
		Background="#0B1220"
		Foreground="#E6EEF9">
	<Window.Styles>
		<Style Selector="TextBlock.cardTitle">
			<Setter Property="Foreground" Value="#8FA7C3" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="SemiBold" />
		</Style>
		<Style Selector="TextBlock.cardValue">
			<Setter Property="Foreground" Value="#ECF4FF" />
			<Setter Property="FontSize" Value="24" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>
		<Style Selector="Button.primaryAction">
			<Setter Property="Background" Value="#2A77FF" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Padding" Value="12,8" />
		</Style>
		<Style Selector="Button.warnAction">
			<Setter Property="Background" Value="#9E1F35" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="Padding" Value="12,8" />
		</Style>
		<Style Selector="Button.cautionAction">
			<Setter Property="Background" Value="#FACC15" />
			<Setter Property="Foreground" Value="#1F2937" />
			<Setter Property="BorderBrush" Value="#FACC15" />
			<Setter Property="BorderThickness" Value="1" />
			<Setter Property="Padding" Value="12,8" />
		</Style>
		<Style Selector="Button.cautionAction:pointerover:not(:disabled)">
			<Setter Property="Background" Value="#EAB308" />
			<Setter Property="BorderBrush" Value="#EAB308" />
		</Style>
		<Style Selector="Button.cautionAction:pressed:not(:disabled)">
			<Setter Property="Background" Value="#CA8A04" />
			<Setter Property="BorderBrush" Value="#CA8A04" />
		</Style>
		<Style Selector="Button.cautionAction:disabled">
			<Setter Property="Background" Value="#6B7280" />
			<Setter Property="BorderBrush" Value="#6B7280" />
			<Setter Property="Foreground" Value="#D1D5DB" />
			<Setter Property="Opacity" Value="0.55" />
		</Style>
		<Style Selector="Button">
			<Setter Property="Padding" Value="10,7" />
			<Setter Property="Margin" Value="0,2,0,2" />
		</Style>
	</Window.Styles>

	<Grid ColumnDefinitions="350,*">
		<Border Grid.Column="0"
				Background="#0F172A"
				BorderBrush="#1E293B"
				BorderThickness="0,0,1,0"
				Padding="20">
			<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
				<StackPanel Spacing="14">
					<StackPanel Spacing="6">
						<TextBlock Text="MANTIS" FontSize="14" FontWeight="Bold" Foreground="#4EA1FF" />
						<TextBlock Text="Malicious Code Scanner" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
						<Border Background="#111B31" BorderBrush="#223357" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,4,0,0">
							<TextBlock Text="This tool scans files, folders, and archives for signs of potentially malicious or unsafe code. It highlights suspicious patterns—such as dynamic code execution—so you can understand what might be harmful, even if you are not a programmer."
									   Foreground="#B7CAE2"
									   TextWrapping="Wrap" />
						</Border>
					</StackPanel>

					<Border Background="#111B31" BorderBrush="#223357" BorderThickness="1" CornerRadius="8" Padding="12">
						<StackPanel Spacing="10">
							<TextBlock Text="Choose what to scan" FontWeight="SemiBold" FontSize="15" />
							<TextBlock Text="Use the buttons below to choose files or folders. For archives and folders, you can also limit the scan to one language."
									   Foreground="#8FA7C3"
									   TextWrapping="Wrap" />

							<TextBlock Text="Select language:"
							   FontWeight="SemiBold"
							   TextWrapping="Wrap"
							   Margin="0,0,0,4" />

							<ComboBox ItemsSource="{Binding ScanLanguageOptions}"
									  SelectedItem="{Binding SelectedScanLanguageOption, Mode=TwoWay}"
									  HorizontalContentAlignment="Stretch">
								<ComboBox.ItemTemplate>
									<DataTemplate>
										<TextBlock Text="{Binding DisplayName}" />
									</DataTemplate>
								</ComboBox.ItemTemplate>
							</ComboBox>


							<Button Content="Browse archives or files"
									Click="PickFileArchiveButton_OnClick" />
							<Button Content="Browse folders"
									Click="PickFolderButton_OnClick" />

							<TextBlock Text="Selected item" FontWeight="SemiBold" Margin="0,8,0,0" />
							<Border Background="#0B1323" BorderBrush="#294776" BorderThickness="1" CornerRadius="6" Padding="8">
								<TextBlock Text="{Binding SelectedPath}"
										   TextWrapping="Wrap"
										   MinHeight="44"
										   MaxHeight="140" />
							</Border>
						</StackPanel>
					</Border>

					<Border Background="#111B31" BorderBrush="#223357" BorderThickness="1" CornerRadius="8" Padding="12">
						<StackPanel Spacing="10">
							<TextBlock Text="Actions" FontWeight="SemiBold" FontSize="15" />
							<TextBlock Text="Run the scan first, then remove the flagged malicious code if needed."
									   Foreground="#8FA7C3"
									   TextWrapping="Wrap" />
							<Button Content="Start scan"
									Classes="primaryAction"
									Click="ScanButton_OnClick"
									IsEnabled="{Binding CanScan}" />
							<Button Content="Annihilate malicious code"
									Classes="warnAction"
									Click="AnnihilateButton_OnClick"
									IsEnabled="{Binding CanAnnihilate}" />
							<Button Content="Clear results"
									Click="ClearButton_OnClick" />
						</StackPanel>
					</Border>

					<Border Background="#111B31" BorderBrush="#223357" BorderThickness="1" CornerRadius="8" Padding="12">
						<StackPanel Spacing="6">
							<TextBlock Text="Status" FontWeight="SemiBold" />
							<TextBlock Text="{Binding StatusMessage}" Foreground="#8FA7C3" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</StackPanel>
			</ScrollViewer>
		</Border>

		<Grid Grid.Column="1"
			  Margin="18"
			  RowDefinitions="Auto,Auto,*,Auto"
			  RowSpacing="12"
			  HorizontalAlignment="Stretch">

				<Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
					<Border Grid.Column="0" Background="#121F38" BorderBrush="#2A4673" BorderThickness="1" CornerRadius="10" Padding="12">
						<StackPanel>
							<TextBlock Text="Files checked" Classes="cardTitle" />
							<TextBlock Text="{Binding FilesScannedText}" Classes="cardValue" />
						</StackPanel>
					</Border>
					<Border Grid.Column="1" Background="#121F38" BorderBrush="#2A4673" BorderThickness="1" CornerRadius="10" Padding="12">
						<StackPanel>
							<TextBlock Text="Data read" Classes="cardTitle" />
							<TextBlock Text="{Binding BytesScannedText}" Classes="cardValue" />
						</StackPanel>
					</Border>
					<Border Grid.Column="2" Background="#121F38" BorderBrush="#2A4673" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0">
						<StackPanel Spacing="6" HorizontalAlignment="Stretch">
							<TextBlock Text="Warnings found" Classes="cardTitle" TextWrapping="Wrap" />
							<TextBlock Text="{Binding WarningCountText}" Classes="cardValue" Foreground="#4EA1FF" TextWrapping="Wrap" />
							<TextBlock Text="Visible after filters" Foreground="#8FA7C3" FontSize="11" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
					<Border Grid.Column="3" Background="#121F38" BorderBrush="#2A4673" BorderThickness="1" CornerRadius="10" Padding="12">
						<StackPanel>
							<TextBlock Text="Warning groups" Classes="cardTitle" />
							<TextBlock Text="{Binding CategorySummary}" Foreground="#D8E8FF" TextWrapping="Wrap" />
						</StackPanel>
					</Border>
				</Grid>

				<Border Grid.Row="1" Background="#101B31" BorderBrush="#263A63" BorderThickness="1" CornerRadius="10" Padding="10" MaxHeight="220" Margin="0">
					<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
						<Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" HorizontalAlignment="Stretch">
							<StackPanel Spacing="3">
								<TextBlock Text="Language overview" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
								<TextBlock Text="The scanner groups results by language and shows what was detected or skipped."
										   Foreground="#8FA7C3"
										   TextWrapping="Wrap" />
							</StackPanel>
							<Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10" HorizontalAlignment="Stretch">
								<Border Background="#0F1A2E" BorderBrush="#263A63" BorderThickness="1" CornerRadius="8" Padding="10">
									<StackPanel Spacing="6">
										<TextBlock Text="Detected languages" Classes="cardTitle" TextWrapping="Wrap" />
										<TextBlock Text="{Binding DetectedLanguagesText}" TextWrapping="Wrap" />
									</StackPanel>
								</Border>
								<Border Grid.Column="1" Background="#0F1A2E" BorderBrush="#263A63" BorderThickness="1" CornerRadius="8" Padding="10">
									<StackPanel Spacing="6">
										<TextBlock Text="Skipped languages" Classes="cardTitle" TextWrapping="Wrap" />
										<TextBlock Text="{Binding SkippedLanguagesText}" TextWrapping="Wrap" />
									</StackPanel>
								</Border>
							</Grid>
							<ItemsControl Grid.Row="2" ItemsSource="{Binding LanguageSummaries}">
								<ItemsControl.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,6,0,0" Background="#132443" BorderBrush="#294776" BorderThickness="1" CornerRadius="8" Padding="10">
											<Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="10" HorizontalAlignment="Stretch">
												<TextBlock Text="{Binding Language}" FontWeight="Bold" TextWrapping="Wrap" />
												<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
													<TextBlock Text="Files:" Foreground="#B7CAE2" />
													<TextBlock Text="{Binding FilesScanned}" Foreground="#B7CAE2" />
												</StackPanel>
												<StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
													<TextBlock Text="Warnings:" Foreground="#B7CAE2" />
													<TextBlock Text="{Binding Detections}" Foreground="#B7CAE2" />
												</StackPanel>
												<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
													<TextBlock Text="Skipped:" Foreground="#B7CAE2" />
													<TextBlock Text="{Binding SkippedFiles}" Foreground="#B7CAE2" />
												</StackPanel>
											</Grid>
										</Border>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Grid>
					</ScrollViewer>
				</Border>

				<Border Grid.Row="2" Background="#101B31" BorderBrush="#263A63" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0">
					<Grid RowDefinitions="Auto,*" RowSpacing="10" HorizontalAlignment="Stretch">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" HorizontalAlignment="Stretch" VerticalAlignment="Top">
							<TextBlock Text="Warnings" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
							<WrapPanel Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="0,0,0,2">
								<ComboBox ItemsSource="{Binding WarningSeverityOptions}" SelectedItem="{Binding SelectedWarningSeverity, Mode=TwoWay}" Margin="0,0,10,8" />
								<ComboBox ItemsSource="{Binding WarningCategoryOptions}" SelectedItem="{Binding SelectedWarningCategory, Mode=TwoWay}" Margin="0,0,10,8" />
								<ComboBox ItemsSource="{Binding WarningSortOptions}" SelectedItem="{Binding SelectedWarningSort, Mode=TwoWay}" Margin="0,0,10,8" />
								<Button Content="Show All" Command="{Binding ShowAllWarningsCommand}" Margin="0,0,10,8" />
								<Border Background="#132443" BorderBrush="#294776" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
									<StackPanel Orientation="Horizontal" Spacing="4">
										<TextBlock Text="Visible:" Foreground="#8FA7C3" TextWrapping="Wrap" />
										<TextBlock Text="{Binding WarningCountText}" Foreground="#E6EEF9" FontWeight="SemiBold" TextWrapping="Wrap" />
									</StackPanel>
								</Border>
							</WrapPanel>
						</Grid>
						<ScrollViewer Grid.Row="1"
								  Margin="0,2,0,0"
								  VerticalScrollBarVisibility="Auto"
								  HorizontalScrollBarVisibility="Disabled"
								  HorizontalAlignment="Stretch">
							<ListBox ItemsSource="{Binding FilteredFindings}"
									 SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
									 Background="Transparent"
									 BorderThickness="0"
									 HorizontalAlignment="Stretch">
								<ListBox.Styles>
									<Style Selector="ListBoxItem">
										<Setter Property="HorizontalContentAlignment" Value="Stretch" />
									</Style>
								</ListBox.Styles>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Margin="0,0,0,6"
												Padding="12"
												CornerRadius="8"
												Background="#132443"
												BorderBrush="#294776"
												BorderThickness="1"
												HorizontalAlignment="Stretch">
											<Grid RowDefinitions="Auto,Auto,Auto"
												  ColumnDefinitions="Auto,*,Auto"
												  ColumnSpacing="10"
												  RowSpacing="5"
												  HorizontalAlignment="Stretch">
												<Border Background="#4EA1FF" CornerRadius="999" Padding="8,2">
													<TextBlock Text="{Binding Severity}" Foreground="#07101F" FontWeight="Bold" FontSize="11" TextWrapping="Wrap" />
												</Border>
												<TextBlock Grid.Column="1" Text="{Binding RuleName}" FontWeight="Bold" TextWrapping="Wrap" />
												<TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="#7FB1FF" HorizontalAlignment="Right" TextWrapping="Wrap" />

												<TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Source}" Foreground="#9AB3CF" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="2" />
												<TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Snippet}" Foreground="#D4E3F8" TextWrapping="Wrap" />
											</Grid>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>
						</ScrollViewer>
					</Grid>
				</Border>

				<Border Grid.Row="3"
						Background="#0F1A2E"
						BorderBrush="#263A63"
						BorderThickness="1"
						CornerRadius="10"
						Padding="12"
						MinHeight="260"
						HorizontalAlignment="Stretch">
					<Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
						<Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" HorizontalAlignment="Stretch" VerticalAlignment="Center">
							<TextBlock Text="Details" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
							<Button Grid.Column="1"
									Content="Annihilate selected malicious code"
									Classes="cautionAction"
									Command="{Binding DeleteSelectedWarningCommand}"
									IsEnabled="{Binding CanDeleteSelectedWarning}"
									HorizontalAlignment="Right"
									Margin="8,0,0,0" />
						</Grid>
						<TextBlock Grid.Row="1" Text="This section explains each warning in plain language." Foreground="#8FA7C3" TextWrapping="Wrap" />
						<Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="16" HorizontalAlignment="Stretch">
							<StackPanel Spacing="7">
								<TextBlock Text="Rule" Foreground="#8FA7C3" />
								<TextBlock Text="{Binding DetailRule}" TextWrapping="Wrap" />
								<TextBlock Text="Severity" Foreground="#8FA7C3" Margin="0,8,0,0" />
								<TextBlock Text="{Binding DetailSeverity}" TextWrapping="Wrap" />
								<TextBlock Text="Group" Foreground="#8FA7C3" Margin="0,8,0,0" />
								<TextBlock Text="{Binding DetailCategory}" TextWrapping="Wrap" />
								<TextBlock Text="Location" Foreground="#8FA7C3" Margin="0,8,0,0" />
								<TextBlock Text="{Binding DetailLine}" TextWrapping="Wrap" MinHeight="22" />
							</StackPanel>
							<StackPanel Grid.Column="1" Spacing="7">
								<TextBlock Text="File" Foreground="#8FA7C3" />
								<TextBlock Text="{Binding DetailSource}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxLines="3" />
								<TextBlock Text="Code sample" Foreground="#8FA7C3" Margin="0,8,0,0" />
								<Border Background="#0B1323" BorderBrush="#263A63" BorderThickness="1" CornerRadius="8" Padding="10">
									<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MinHeight="110">
										<TextBlock Text="{Binding DetailSnippet}" FontFamily="Consolas" TextWrapping="Wrap" />
									</ScrollViewer>
								</Border>
							</StackPanel>
						</Grid>
					</Grid>
				</Border>
			</Grid>
	</Grid>
</Window>
